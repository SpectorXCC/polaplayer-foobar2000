{
  "name": "polaplayer-foobar2000",
  "version": "2.0.0",
  "description": "A modern foobar2000 interface for local music and Navidrome, based on Verdant.",
  "license": "MIT",
  "author": "SpectorXCC",
  "contributors": ["superziper (original Verdant author)"],
  "repository": { "type": "git", "url": "https://github.com/SpectorXCC/polaplayer-foobar2000.git" },
  "scripts": {
    "check": "node scripts/check.js",
    "lint:strings": "node scripts/lint-strings.js",
    "test": "node tests/run.js",
    "build:web": "node fullscreen-web/build.mjs",
    "build:native": "powershell -ExecutionPolicy Bypass -File native/build.ps1",
    "build:all": "npm run build:native && npm run build:web"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
